# VideoForge Translation Pipeline — Environment Variables
# Copy to .env and fill in your keys

# === Transcription (AssemblyAI) ===
ASSEMBLYAI_API_KEY=your_assemblyai_key

# === Translation (Claude / Anthropic) ===
ANTHROPIC_API_KEY=your_anthropic_key

# === TTS (MiniMax) ===
MINIMAX_API_KEY=your_minimax_key

# === Douyin cookies (optional, for authenticated downloads) ===
# DOUYIN_COOKIES_PATH=/path/to/cookies.txt

# DreamFace Lip Sync API
DREAMFACE_API_KEY=sk-your-key-here
PUBLIC_BASE_URL=https://your-domain.com  # needed for DreamFace to access local files
